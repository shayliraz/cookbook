# Spoonacular API Key (optional)
# Get your free API key at: https://spoonacular.com/food-api
# Free tier: 150 requests/day
# If not set, the app will use fallback scraping from popular recipe sites
SPOONACULAR_API_KEY=your_api_key_here

# Supabase Configuration (required for user accounts & cloud sync)
# Create a free project at: https://supabase.com
# Find these values in: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
